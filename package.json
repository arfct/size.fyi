{
  "name": "size.fyi",
  "version": "0.0.1",
  "private": true,
  "description": "Compare the size of everyday objects — a modern sizeasy",
  "scripts": {
    "dev": "node scripts/build-catalog.mjs && vite",
    "build": "node scripts/build-catalog.mjs && vite build",
    "test": "vitest run",
    "test:worker": "npm run build && vitest run -c vitest.workers.config.mts",
    "validate": "node scripts/build-catalog.mjs --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker/tsconfig.json",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "workerd@1.20260714.1": true
  }
}
