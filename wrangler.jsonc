{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "size-fyi",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-19",
  "account_id": "c0912e10eadeaa117b0067ab29b55da6",
  "routes": [
    { "pattern": "size.fyi", "custom_domain": true },
    { "pattern": "www.size.fyi", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Deliberately NOT single-page-application. That made every miss return index.html with a 200,
    // which broke two things: a mistyped /models/*.usdz handed AR Quick Look a web page and a success
    // code, and an ASSETS.fetch for a missing geometry layer looked like a hit. The Worker serves the
    // app shell for real app routes itself and 404s anything that looks like a file — see src/worker.
    "not_found_handling": "none"
  }
}
